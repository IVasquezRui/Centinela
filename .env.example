# Copiar a ".env" y ajustar antes de "docker compose up".
# ".env" NUNCA se commitea (ver .gitignore) y NO contiene credenciales:
# las contraseñas y la API key viven en secrets/ (las genera scripts/gen-secrets.sh)
# y docker-compose las monta como Docker secrets en /run/secrets.

# --- Base de datos de inteligencia (centinela-db) ---
# Superusuario/Owner (solo para inicialización/migraciones y scripts de mantenimiento como reset-db)
POSTGRES_USER=centinela
POSTGRES_DB=centinela

# centinela-core NUNCA se conecta como el superusuario de arriba: usa el rol
# de mínimos privilegios "centinela_app" que crea db/init/03_grants.sh. No hay
# variable de contraseña propia para ese rol: su password se deriva en tiempo
# de arranque (sha256 a partir del secreto del superusuario, ver
# secrets/README.md y app/config.py::derive_app_db_password). Conectarse como
# superusuario anularía en la práctica los REVOKE de auditoría.

# --- Objetivo vulnerable A: gov-pago / MySQL (laboratorio aislado, datos sintéticos) ---
GOV_MYSQL_DATABASE=tributos_db

# --- Copiloto IA (DeepSeek, API compatible con OpenAI) ---
# La API key NO se escribe aquí: se pega en secrets/deepseek_api_key.txt.
# Vacía => plantilla de respaldo y la plataforma funciona igual.
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=3

# --- Motor de reglas / IPS ---
BLOCKLIST_THRESHOLD=3
BLOCKLIST_WINDOW_SECONDS=60
BLOCKLIST_QUARANTINE_SECONDS=300

# --- Confianza de proxies ---
# CIDR separados por coma de los proxies cuyo X-Forwarded-For se acepta.
# Vacío = no se acepta la cabecera de nadie (evita suplantar la IP de origen).
TRUSTED_PROXIES=

# --- Modelo ML (volumen ./ml/model -> /app/ml/model) ---
ML_MODEL_PATH=/app/ml/model/nsl_kdd_rf.joblib

# --- Puertos expuestos en el host ---
GATEWAY_PORT=8080
API_PORT=3000
FRONTEND_PORT=5173

